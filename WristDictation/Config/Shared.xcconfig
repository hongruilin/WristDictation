// ============================================================
// 签名与标识配置
// 改这一个文件即可，两个 Target 都会跟着变。
// ============================================================

// 你的 iOS Bundle Identifier。必须与描述文件里注册的一致。
// Watch App 会自动使用 <APP_BUNDLE_ID>.watchkitapp
// 注意：不要用 com.example.* —— example.com 是保留域名，App ID 注册会被拒。
APP_BUNDLE_ID = com.yourname.wristdictation

// 你的 Apple Developer Team ID（10 位，如 A1B2C3D4E5）。
// 留空则需要在 Xcode 的 Signing & Capabilities 里手动选择团队。
DEVELOPMENT_TEAM =

CODE_SIGN_STYLE = Automatic
